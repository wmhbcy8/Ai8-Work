{
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "quoteProps": "as-needed",
  "jsxSingleQuote": true,
  "bracketSameLine": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.webpack/**",
    "**/resources/**",
    "**/public/**",
    "**/mobile/**",
    "**/scripts/**",
    "**/docs/**",
    "**/tapnow.html",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.lock"
  ]
}
